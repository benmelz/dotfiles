[core]
	editor = vim
	excludesfile = ~/.config/git/exclude
[init]
	defaultBranch = main
[pull]
	rebase = false
[user]
	name = benmelz
	email = ben@melz.me
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[diff "rails_credentials"]
	textconv = rails credentials:diff
	cachetextconv = false
